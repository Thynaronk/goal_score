s\n\n"]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"}]}],"snapshots":[{"timestamp":1785819046148,"editorVersion":"9.0.8","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"Goal_Score\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1785821184976,"editorVersion":"9.0.8","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"225\" y=\"20\"></block></xml>","main.ts":"","README.md":"","main.py":"score = 0\n\n# 1. SETUP: Stop \"constant scoring\" by pulling Pin 16 HIGH by default\n# This means the score only triggers when P16 touches GND (pulls to 0)\npins.set_pull(DigitalPin.P16, PinPullMode.PULL_UP)\n\n# Center the goalkeeper at 90 degrees on start\npins.servo_write_pin(AnalogPin.P1, 90)\n\n# Button A resets the score to zero\ndef on_button_pressed_a():\n    global score\n    score = 0\n    basic.show_number(score)\n    basic.clear_screen()\ninput.on_button_pressed(Button.A, on_button_pressed_a)\n\ndef on_forever():\n    global score\n    \n    # 2. SCOREBOARD: Triggered when ball connects Pin 16 and GND\n    if pins.digital_read_pin(DigitalPin.P16) == 0:\n        score += 1\n        \n        # Flashing LED celebration and sound\n        music.play_tone(262, music.beat(BeatFraction.WHOLE))\n        for i in range(2):\n            basic.show_icon(IconNames.SQUARE)\n            basic.pause(100)\n            basic.clear_screen()\n            basic.pause(100)\n        \n        # Display the current score\n        basic.show_number(score)\n        # Debounce: Wait 1 second before next point to avoid double-counting\n        basic.pause(1000)\n\n    # 3. GOALKEEPER: Triggered by IR sensor on Pin 2\n    if pins.digital_read_pin(DigitalPin.P2) == 0:\n        # Move randomly to far left (0) or far right (180)\n        targets =\n        random_index = randint(0, 1)\n        target_angle = targets[random_index]\n        \n        # Move at maximum hardware speed by writing directly to the pin\n        pins.servo_write_pin(AnalogPin.P1, target_angle)\n        \n        # Pause briefly to allow the motor to finish the move\n        basic.pause(300)\n        \n        # Always return to 90 degrees center before the next move\n        pins.servo_write_pin(AnalogPin.P1, 90)\n        basic.pause(500)\n    else:\n        # Stay at 90 degrees when no ball is detected\n        pins.servo_write_pin(AnalogPin.P1, 90)\n\n    basic.pause(100)\n\nbasic.forever(on_forever)\n","pxt.json":"{\n    \"name\": \"Goal_Score\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"pyprj\"\n}\n"}}],"shares":[],"lastSaveTime":1785822816697}