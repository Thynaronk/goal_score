1, target_angle)\n        basic.pause(300)\n        \n        # Return to 90 degrees center\n        pins.servo_write_pin(AnalogPin.P1, 90)\n        basic.pause(500)\n    else:\n        # Stay at 90 when no object is detected\n        pins.servo_write_pin(AnalogPin.P1, 90)\n\n    basic.pause(100)\n\nbasic.forever(on_forever)\n"}]},{"timestamp":1785819159314,"editorVersion":"9.0.8","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":1,"diffs":[[1,"let score = 0\n//  Initial center position\npins.servoWritePin(AnalogPin.P1, 90)\n//  Button A resets the scoreboard\ninput.onButtonPressed(Button.A, function on_button_pressed_a() {\n    \n    score = 0\n    basic.showNumber(score)\n    basic.clearScreen()\n})\nbasic.forever(function on_forever() {\n    let targets: number[];\n    let random_index: number;\n    let target_angle: number;\n    \n    //  1. SCOREBOARD (Aluminum Foil on Pin 8 and GND)\n    //  0 means the ball hit the foil, closing the circuit\n    if (pins.digitalReadPin(DigitalPin.P8) == 0) {\n        score += 1\n        //  Play a sound (Middle C)\n        music.playTone(262, music.beat(BeatFraction.Whole))\n        //  Flashing LED Series for celebration\n        for (let i = 0; i < 4; i++) {\n            basic.showIcon(IconNames.Square)\n            basic.pause(100)\n            basic.clearScreen()\n            basic.pause(100)\n        }\n        //  Display current score\n        basic.showNumber(score)\n        basic.pause(1000)\n    }\n    \n    //  Wait to avoid double-scoring\n    //  2. GOALKEEPER (IR on Pin 2)\n    if (pins.digitalReadPin(DigitalPin.P2) == 0) {\n        //  Define specific angles\n        targets = []\n        //  Fixed: Pick a random index (0 or 1)\n        random_index = randint(0, 1)\n        target_angle = targets[random_index]\n        //  Move at maximum hardware speed\n        pins.servoWritePin(AnalogPin.P1, target_angle)\n        basic.pause(300)\n        //  Return to 90 degrees center\n        pins.servoWritePin(AnalogPin.P1, 90)\n        basic.pause(500)\n    } else {\n        //  Stay at 90 when no object is detected\n        pins.servoWritePin(AnalogPin.P1, 90)\n    }\n    \n    basic.pause(100)\n})\n"]]}]},{"type":"edited","filename":"main.py","patch":[{"start1":10,"length1":0,"diffs":[[1,"# Initial center position\npins.servo_write_pin(AnalogPin.P1, 90)\n"]]},{"start1":76,"length1":127,"diffs":[[1,"# Button A resets the scoreboard\ndef on_button_pressed_a():\n    global score\n    score = 0\n    basic.show_number(score)\n    basic.clear_screen()\ninput.on_button_pressed(Button.A, on_button_pressed_a)\n"]]},{"start1":312,"length1":76,"diffs":[[1,"    # 1. SCOREBOARD (Aluminum Foil on Pin 8 and GND)\n    # 0 means the ball hit the foil, closing the circuit\n"]]},{"start1":500,"length1":45,"diffs":[[1,"        # Play a sound (Middle C)\n"]]},{"start1":595,"length1":27,"diffs":[[1,"        \n        # Flashing LED Series for celebration\n        for i in range(4):\n"]]},{"start1":827,"length1":0,"diffs":[[1,"        # Display current score\n"]]},{"start1":892,"length1":174,"diffs":[[1,"        basic.pause(1000) # Wait to avoid double-scoring\n"]]},{"start1":950,"length1":29,"diffs":[[1,"    # 2. GOALKEEPER (IR on Pin 2)\n"]]},{"start1":1034,"length1":0,"diffs":[[1,"        # Define specific angles\n"]]},{"start1":1085,"length1":63,"diffs":[[1,"        \n        # Fixed: Pick a random index (0 or 1)\n        random_index = randint(0, 1)\n        target_angle = targets[random_index]\n        \n        # Move at maximum hardware speed\n        pins.servo_write_pin(AnalogPin.P1, target_angle)\n        basic.pause(300)\n        \n        # Return to 90 degrees center\n        pins.servo_write_pin(AnalogPin.P1, 90)\n"]]},{"start1":1473,"length1":0,"diffs":[[1,"    else:\n        # Stay at 90 when no object is detected\n"]]},{"start1":1579,"length1":0,"diffs":[[1,"    basic.pause(100)\n\n"]]}]}]},{"timestamp":1785819693305,"editorVersion":"9.0.8","changes":[{